# URL base del backend (sin barra final). Por defecto la app usa Render:
EXPO_PUBLIC_API_BASE_URL=https://lifesync-mobile.onrender.com/api

# Opcional: usar el backend local de la laptop (puerto 5000) en lugar de Render.
# Comenta EXPO_PUBLIC_API_BASE_URL y descomenta la siguiente línea:
# EXPO_PUBLIC_USE_LOCAL_API=true
