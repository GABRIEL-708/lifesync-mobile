# LifeSync Backend – Environment Variables
# Copy this file to .env and fill in real values before running.

# ── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── MongoDB ────────────────────────────────────────────────────────────────────
# Example: mongodb://localhost:27017/lifesync
# Example (Atlas): mongodb+srv://<user>:<password>@cluster.mongodb.net/lifesync
MONGODB_URI=

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
# Example: http://localhost:3000,https://app.lifesync.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
